  useEffect(() => {
    if (document.getElementById("agora-fonts")) return;
    const l1 = document.createElement("link");
    l1.id = "agora-fonts"; l1.rel = "stylesheet";
    l1.href = "https://cdn.jsdelivr.net/fontsource/css/inter@latest/index.css";
    const l2 = document.createElement("link");
    l2.rel = "stylesheet";
    l2.href = "https://cdn.jsdelivr.net/fontsource/css/jetbrains-mono@latest/index.css";
    document.head.appendChild(l1); document.head.appendChild(l2);
    const st = document.createElement("style");
    st.textContent = `
