  const NavItem = ({ item, badge }) => {
    const active = tab === item.id;
    return (
      <button onClick={() => { setTab(item.id); setMoreOpen(false); }}
        className="w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-[13px] font-medium transition-all mb-0.5"
        style={active ? { background: "linear-gradient(135deg, rgba(77,107,254,.18), rgba(108,140,255,.08))", color: "#93AAFF", boxShadow: `inset 0 0 0 1px ${T.accent}44` } : { color: "#8B94A8" }}
        onMouseEnter={(e) => { if (!active) e.currentTarget.style.background = "#141926"; }}
        onMouseLeave={(e) => { if (!active) e.currentTarget.style.background = "transparent"; }}>
        <span style={active ? { color: T.accentSoft } : {}}>{item.icon}</span>
        <span className="flex-1 text-left">{item.label}</span>
        {!!badge && <span className="w-5 h-5 rounded-full bg-[#F16A5E] text-white text-[10px] font-bold flex items-center justify-center">{badge}</span>}
      </button>
    );
  };

  const roomChip = (
    <button onClick={() => { navigator.clipboard?.writeText(room).then(() => notify(`Código ${room} copiado. Compartilhe para conectar outros dispositivos.`)).catch(() => notify(`Código da sala: ${room}`)); }}
      className="flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-xs font-bold transition-colors hover:border-[#4D6BFE66]"
      style={{ borderColor: T.border, background: T.surface, color: T.accentSoft }} title="Copiar código da sala">
      <IconCopy size={12} /> {room}
    </button>
  );

  return (
    <div style={{ background: T.bg, color: T.text, minHeight: "100vh", fontFamily: "'Inter', system-ui, sans-serif" }} className="flex">
      <GlobalStyles />

      {/* ============ SIDEBAR (desktop) ============ */}
      <aside className="hidden lg:flex flex-col w-[248px] shrink-0 border-r sticky top-0 h-screen" style={{ borderColor: T.border, background: "#0D1119" }}>
        <div className="px-5 py-5 flex items-center gap-3">
          <div className="w-9 h-9 rounded-xl flex items-center justify-center" style={{ background: "linear-gradient(135deg,#4D6BFE,#6C8CFF)" }}>
            <IconScale size={19} className="text-white" />
          </div>
          <div>
            <div className="font-extrabold text-[15px] tracking-tight">Ágora<span style={{ color: T.accentSoft }}>EDU</span></div>
            <div className="text-[10px] text-[#5A6376] font-medium tracking-widest uppercase">Educação Política</div>
          </div>
        </div>

        <div className="px-5 pb-3">{roomChip}</div>

        <nav className="flex-1 overflow-y-auto px-3 mt-1 space-y-5">
          <div>
            <div className="px-2 mb-1.5 text-[10px] font-bold tracking-widest uppercase text-[#4A5265]">Sala ao vivo</div>
            {mainTabs.map((it) => <NavItem key={it.id} item={it} />)}
          </div>
          <div>
            <div className="px-2 mb-1.5 text-[10px] font-bold tracking-widest uppercase text-[#4A5265]">{isStaff ? "Professor / Coordenação" : "Comunidade"}</div>
            {moreTabs.map((it) => <NavItem key={it.id} item={it} badge={it.id === "moderacao" ? pendingCount : 0} />)}
          </div>
        </nav>

        <div className="p-3">
          <div className="rounded-xl p-3 border" style={{ background: T.surface, borderColor: T.border }}>
            <div className="flex items-center gap-2 text-[10px] font-bold mb-2.5" style={{ color: syncChip.color }}>
              {net.status === "offline" ? <IconWifiOff size={13} /> : <IconWifi size={13} />} {syncChip.label}
            </div>
            <div className="flex items-center gap-2.5">
              <Avatar name={me.name} size={32} />
              <div className="min-w-0 flex-1">
                <div className="text-xs font-semibold truncate">{me.name}</div>
                <div className="text-[10px] text-[#5A6376]">{me.role === "student" ? `Estudante${me.turma ? ` • ${me.turma}` : ""}` : me.role === "teacher" ? "Professor(a)" : "Coordenador(a)"} • {myXp} XP</div>
              </div>
            </div>
            <div className="flex gap-1.5 mt-3">
              <button onClick={onChangeRoom} className="flex-1 text-[10px] font-bold py-1.5 rounded-lg border transition-colors hover:border-[#4D6BFE66]" style={{ borderColor: T.border, color: T.muted }}>Trocar sala</button>
              <button onClick={onLogout} className="flex-1 text-[10px] font-bold py-1.5 rounded-lg border transition-colors hover:border-[#F16A5E66] hover:text-[#FF8A80]" style={{ borderColor: T.border, color: T.muted }}>Sair</button>
