const Countdown = ({ endsAt, urgentBelow = 60 }) => {
  const [left, setLeft] = useState(() => Math.max(0, Math.floor((endsAt - Date.now()) / 1000)));
  useEffect(() => {
    setLeft(Math.max(0, Math.floor((endsAt - Date.now()) / 1000)));
    const t = setInterval(() => setLeft(Math.max(0, Math.floor((endsAt - Date.now()) / 1000))), 1000);
    return () => clearInterval(t);
  }, [endsAt]);
  const urgent = left <= urgentBelow && left > 0;
  return (
    <span className="font-extrabold" style={{ color: urgent ? T.danger : "inherit", fontVariantNumeric: "tabular-nums", fontFamily: "'JetBrains Mono', monospace" }}>
      {left <= 0 ? "00:00" : fmtClock(left)}
    </span>
  );
};

const Elapsed = ({ since }) => {
  const [s, setS] = useState(() => Math.floor((Date.now() - since) / 1000));
  useEffect(() => { const t = setInterval(() => setS(Math.floor((Date.now() - since) / 1000)), 1000); return () => clearInterval(t); }, [since]);
  return <span style={{ fontVariantNumeric: "tabular-nums", fontFamily: "'JetBrains Mono', monospace" }}>{fmtClock(s)}</span>;
};

/* ---------- Chat com bolinha de novas mensagens (sem rolar a página) ---------- */
const ChatBox = ({ messages, me, onSend, onReport, muted, height = 380 }) => {
  const boxRef = useRef(null);
  const [atBottom, setAtBottom] = useState(true);
  const [unseen, setUnseen] = useState(0);
  const [text, setText] = useState("");
  const lastCount = useRef(messages.length);

  useEffect(() => {
    const el = boxRef.current;
    if (!el) return;
    if (messages.length > lastCount.current) {
      if (atBottom) el.scrollTop = el.scrollHeight;
      else setUnseen((u) => u + (messages.length - lastCount.current));
    }
    lastCount.current = messages.length;
  }, [messages, atBottom]);

  const handleScroll = () => {
    const el = boxRef.current;
    if (!el) return;
    const dist = el.scrollHeight - el.scrollTop - el.clientHeight;
    if (dist < 56) { setAtBottom(true); setUnseen(0); }
    else setAtBottom(false);
  };
  const jumpToBottom = () => {
    const el = boxRef.current;
    if (el) el.scrollTo({ top: el.scrollHeight, behavior: "smooth" });
    setAtBottom(true); setUnseen(0);
  };
  const submit = () => {
    const v = text.trim();
    if (!v || muted) return;
    onSend(v); setText("");
    setAtBottom(true); setUnseen(0);
    requestAnimationFrame(() => { const el = boxRef.current; if (el) el.scrollTop = el.scrollHeight; });
  };

  return (
    <Card className="flex flex-col overflow-hidden" style={{ height }}>
      <div className="px-4 py-3 border-b flex items-center justify-between shrink-0" style={{ borderColor: T.border }}>
        <div className="flex items-center gap-2"><IconMsg size={15} className="text-[#6C8CFF]" /><span className="text-sm font-bold">Chat ao vivo</span></div>
        <Pill color={T.ok}><span className="w-1.5 h-1.5 rounded-full bg-[#34D399] animate-pulse" />Moderado</Pill>
      </div>
      <div className="flex-1 relative min-h-0">
        <div ref={boxRef} onScroll={handleScroll} className="absolute inset-0 overflow-y-auto p-4 space-y-3">
          {messages.length === 0 && (
            <div className="text-center text-[11px] text-[#5A6376] pt-8 px-4 leading-relaxed">
              Nenhuma mensagem ainda. Seja a primeira pessoa a comentar — as mensagens aparecem aqui em tempo real para todos os dispositivos da sala.
            </div>
          )}
          {messages.map((m) => (
            <div key={m.id} className="flex items-start gap-2.5 group">
              <Avatar name={m.author} size={26} />
              <div className="min-w-0 flex-1">
                <div className="flex items-center gap-2">
                  <span className="text-[11px] font-bold text-[#93AAFF]">{m.author}{m.authorId === me.id ? " (você)" : ""}</span>
                  <span className="text-[9px] text-[#3D465C]">{fmtWhen(m.ts)}</span>
                  {m.authorId !== me.id && (
                    <button onClick={() => onReport(m)} title="Denunciar" className="opacity-0 group-hover:opacity-100 transition-opacity text-[#5A6376] hover:text-[#F16A5E] ml-auto shrink-0">
                      <IconFlag size={12} />
                    </button>
                  )}
                </div>
                <p className="text-xs text-[#B8C0D0] leading-relaxed break-words">{m.text}</p>
              </div>
            </div>
          ))}
        </div>
        {/* Bolinha minimalista de novas mensagens */}
        <AnimatePresence>
          {!atBottom && unseen > 0 && (
            <motion.button initial={{ opacity: 0, scale: 0.7 }} animate={{ opacity: 1, scale: 1 }} exit={{ opacity: 0, scale: 0.7 }}
              onClick={jumpToBottom} title="Novas mensagens"
              className="absolute bottom-3 right-3 w-9 h-9 rounded-full flex items-center justify-center shadow-lg z-10"
              style={{ background: T.accent, color: "#fff", boxShadow: "0 4px 18px rgba(77,107,254,.5)" }}>
              <IconChevDown size={16} />
              {unseen > 0 && (
                <span className="absolute -top-1 -right-1 min-w-[16px] h-4 px-1 rounded-full bg-[#F16A5E] text-white text-[9px] font-extrabold flex items-center justify-center">{unseen > 9 ? "9+" : unseen}</span>
              )}
            </motion.button>
          )}
        </AnimatePresence>
      </div>
      <div className="p-3 border-t shrink-0" style={{ borderColor: T.border }}>
        <div className="flex gap-2">
          <input value={text} onChange={(e) => setText(e.target.value)} onKeyDown={(e) => e.key === "Enter" && submit()} disabled={muted}
            placeholder={muted ? "Você foi silenciado pela moderação" : "Mensagem no chat…"}
            className="flex-1 min-w-0 rounded-xl px-3.5 py-2.5 text-xs border outline-none focus:border-[#4D6BFE] placeholder:text-[#5A6376] disabled:opacity-50"
            style={{ background: "#0B0E15", borderColor: T.border, color: T.text }} />
          <Btn size="sm" onClick={submit} disabled={muted || !text.trim()}><IconSend size={13} /></Btn>
        </div>
      </div>
    </Card>
  );
};

