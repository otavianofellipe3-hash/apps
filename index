const Avatar = ({ name, size = 36, ring }) => {
  const safe = (name || "?").trim();
  const ini = safe.split(" ").map((w) => w[0]).slice(0, 2).join("").toUpperCase() || "?";
  const hue = (safe.charCodeAt(0) * 37 + safe.length * 91) % 60;
  return (
    <div style={{
      width: size, height: size, minWidth: size, borderRadius: "50%", display: "flex", alignItems: "center", justifyContent: "center",
      background: `linear-gradient(135deg, hsl(${220 + (hue % 30)}, 70%, 40%), hsl(${200 + hue}, 85%, 56%))`,
      color: "#fff", fontSize: size * 0.36, fontWeight: 700,
      boxShadow: ring ? `0 0 0 2px ${T.bg}, 0 0 0 4px ${T.accent}` : "0 2px 8px rgba(0,0,0,.4)",
    }}>{ini}</div>
  );
};

