export default function App() {
  const [session, setSession] = useState(loadSession);
  const [googleReturn, setGoogleReturn] = useState(false);

  useEffect(() => {
    try {
      const params = new URLSearchParams(window.location.search);
      const flag = params.get("gauth") === "1" || sessionStorage.getItem("agoraedu_gauth") === "1";
      if (flag) {
        setGoogleReturn(true);
        sessionStorage.removeItem("agoraedu_gauth");
        params.delete("gauth");
        const clean = `${window.location.pathname}${params.toString() ? `?${params}` : ""}`;
        window.history.replaceState({}, "", clean);
      }
    } catch (e) {}
  }, []);

  const handleAuth = (user) => {
    const s = { id: user.id, name: user.name, email: user.email, role: user.role, turma: user.turma || "", pass: user.pass, google: !!user.google, room: null };
    saveSession(s);
    setSession(s);
    setGoogleReturn(false);
  };
  const handleLogout = () => { saveSession(null); setSession(null); };
  const handleJoinRoom = (room) => {
    const s = { ...session, room: room.toUpperCase() };
    saveSession(s); setSession(s);
  };
  const handleChangeRoom = () => {
    const s = { ...session, room: null };
    saveSession(s); setSession(s);
  };

  if (!session) return (<><GlobalStyles /><AuthScreen onAuth={handleAuth} googleReturn={googleReturn} /></>);
  if (!session.room) return (<><GlobalStyles /><RoomGate session={session} onJoin={handleJoinRoom} onLogout={handleLogout} /></>);
  return (<><GlobalStyles /><SyncedApp key={`${session.id}-${session.room}`} session={session} onLogout={handleLogout} onChangeRoom={handleChangeRoom} /></>);
}

