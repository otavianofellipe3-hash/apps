                <input className={inputCls} style={inputStyle} value={name} onChange={(e) => setName(e.target.value)} placeholder="Como você será identificado na sala" autoComplete="name" required />
              </div>
              <div>
                <label className={labelCls}>Papel na escola</label>
                <div className="grid grid-cols-3 gap-2">
                  {[["student", "Estudante"], ["teacher", "Professor"], ["coordinator", "Coordenador"]].map(([r, l]) => (
                    <button key={r} type="button" onClick={() => setRole(r)}
