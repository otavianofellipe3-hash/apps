              </div>
              <div className="flex gap-2 mt-3">
                <button onClick={() => { setMoreOpen(false); onChangeRoom(); }} className="flex-1 py-3 rounded-xl border text-xs font-bold text-[#8B94A8]" style={{ borderColor: T.border }}>Trocar de sala</button>
                <button onClick={() => { setMoreOpen(false); onLogout(); }} className="flex-1 py-3 rounded-xl border text-xs font-bold text-[#FF8A80]" style={{ borderColor: "#F16A5E44" }}>Encerrar sessão</button>
              </div>
            </motion.div>
          </>
        )}
      </AnimatePresence>

      {/* Toast */}
      <AnimatePresence>
        {toast && (
          <motion.div initial={{ opacity: 0, y: 24, scale: .95 }} animate={{ opacity: 1, y: 0, scale: 1 }} exit={{ opacity: 0, y: 16 }}
            className="fixed bottom-24 lg:bottom-6 left-1/2 -translate-x-1/2 z-[60] px-4 py-2.5 rounded-xl border shadow-2xl text-xs sm:text-sm font-semibold flex items-center gap-2 max-w-[92vw]"
            style={{ background: "#161C2A", borderColor: toast.tone === "xp" ? T.accent : toast.tone === "warn" ? "#F5A52466" : T.border, color: T.text }}>
            {toast.tone === "xp" ? <IconZap size={14} className="text-[#6C8CFF]" /> : toast.tone === "warn" ? <IconFlag size={14} className="text-[#F5A524]" /> : <IconCheck size={14} className="text-[#34D399]" />}
            <span className="truncate">{toast.msg}</span>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}

