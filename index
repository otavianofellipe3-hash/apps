const DebatePage = ({ data, me, isStaff, act, iAmMuted }) => {
  const [form, setForm] = useState({ motion: "", favorTeam: "", contraTeam: "", minutes: "8" });
  const [newArg, setNewArg] = useState("");
  const [argSide, setArgSide] = useState("favor");
  const deb = data.debate;

  const favorArgs = useMemo(() => data.args.filter((a) => a.side === "favor").sort((x, y) => y.ts - x.ts), [data.args]);
  const contraArgs = useMemo(() => data.args.filter((a) => a.side === "contra").sort((x, y) => y.ts - x.ts), [data.args]);
  const favorVotes = favorArgs.reduce((acc, a) => acc + voteCount(a.voters), 0);
  const contraVotes = contraArgs.reduce((acc, a) => acc + voteCount(a.voters), 0);
  const totalVotes = favorVotes + contraVotes;
  const favorPct = totalVotes > 0 ? Math.round((favorVotes / totalVotes) * 100) : 50;

  const startDebate = () => {
    if (!form.motion.trim()) return;
    const mins = Math.max(1, parseInt(form.minutes, 10) || 8);
    act.startDebate({
      motion: form.motion.trim(),
      favorTeam: form.favorTeam.trim() || "Lado A",
      contraTeam: form.contraTeam.trim() || "Lado B",
      endsAt: Date.now() + mins * 60000,
      roundMinutes: mins,
    });
  };

  if (!deb) {
    return (
      <div className="max-w-[680px] mx-auto">
        {isStaff ? (
          <Card className="p-5 sm:p-6">
            <SectionTitle icon={<IconScale size={18} />} title="Abrir arena de debate" sub="Todos os dispositivos da sala veem a tese, os lados e o cronômetro sincronizados" />
            <div className="space-y-3">
              <div><label className="text-[10px] font-bold tracking-widest uppercase text-[#5A6376] mb-1.5 block">Tese em debate</label>
                <Input textarea value={form.motion} onChange={(v) => setForm({ ...form, motion: v })} placeholder='Ex.: "A educação política deve ser disciplina obrigatória no Ensino Médio."' /></div>
              <div className="grid sm:grid-cols-2 gap-3">
                <div><label className="text-[10px] font-bold tracking-widest uppercase text-[#6C8CFF] mb-1.5 block">Equipe a favor</label>
                  <Input value={form.favorTeam} onChange={(v) => setForm({ ...form, favorTeam: v })} placeholder="Ex.: 3º A" /></div>
                <div><label className="text-[10px] font-bold tracking-widest uppercase text-[#F5A524] mb-1.5 block">Equipe contra</label>
                  <Input value={form.contraTeam} onChange={(v) => setForm({ ...form, contraTeam: v })} placeholder="Ex.: 2º B" /></div>
              </div>
              <div><label className="text-[10px] font-bold tracking-widest uppercase text-[#5A6376] mb-1.5 block">Minutos por turno</label>
                <Input type="number" value={form.minutes} onChange={(v) => setForm({ ...form, minutes: v })} placeholder="8" /></div>
              <Btn className="w-full" onClick={startDebate} disabled={!form.motion.trim()}><IconScale size={14} /> Abrir arena</Btn>
            </div>
          </Card>
        ) : (
          <Card><Empty icon={<IconScale size={24} />} title="Nenhum debate ativo"
            sub="Quando o professor abrir uma arena, a tese, o cronômetro e os argumentos aparecerão aqui em tempo real para você participar." /></Card>
        )}
      </div>
    );
  }

  return (
    <div className="max-w-[1400px] mx-auto space-y-4">
      <Card className="p-4 sm:p-5 relative overflow-hidden" style={{ background: "linear-gradient(120deg, rgba(77,107,254,.10), #11151F 45%, rgba(245,165,36,.06))" }}>
        <div className="flex flex-col md:flex-row md:items-center gap-4 justify-between">
          <div className="flex items-start gap-3 min-w-0">
            <div className="w-11 h-11 rounded-2xl flex items-center justify-center shrink-0" style={{ background: "linear-gradient(135deg,#4D6BFE,#6C8CFF)" }}>
              <IconScale size={20} className="text-white" />
            </div>
            <div className="min-w-0">
              <div className="flex items-center gap-2 mb-1 flex-wrap">
                <Pill color="#FF8A80" bg="#F16A5E1A"><span className="w-1.5 h-1.5 rounded-full bg-[#F16A5E] animate-pulse" />EM ANDAMENTO</Pill>
                <Pill color={T.muted}>Rodada {deb.round}</Pill>
              </div>
              <h2 className="text-sm sm:text-base font-extrabold tracking-tight leading-snug">{deb.motion}</h2>
              <div className="text-[11px] text-[#8B94A8] mt-1">{deb.favorTeam} (a favor) × {deb.contraTeam} (contra) • aberto por {deb.hostName}</div>
            </div>
          </div>
          <div className="text-center shrink-0 px-5 py-3 rounded-2xl border self-start md:self-auto" style={{ borderColor: T.border, background: "rgba(11,14,21,.6)" }}>
            <div className="text-[10px] font-bold tracking-widest uppercase text-[#5A6376]">Tempo do turno</div>
            <div className="text-3xl mt-1"><Countdown endsAt={deb.endsAt} /></div>
            {isStaff && me.id === deb.hostId && (
              <div className="flex gap-1.5 mt-2 justify-center">
                <button onClick={() => act.extendDebate(deb.roundMinutes || 5)} className="text-[10px] font-bold px-2 py-1 rounded-lg border transition-colors hover:border-[#4D6BFE88]" style={{ borderColor: T.border, color: T.accentSoft }}>+ turno</button>
                <button onClick={act.endDebate} className="text-[10px] font-bold px-2 py-1 rounded-lg border transition-colors hover:border-[#F16A5E88] hover:text-[#FF8A80]" style={{ borderColor: T.border, color: T.muted }}>Encerrar</button>
              </div>
            )}
          </div>
        </div>

        <div className="mt-4">
          <div className="flex justify-between text-[11px] font-bold mb-1.5">
            <span style={{ color: T.accentSoft }}>A FAVOR • {favorPct}%</span>
            <span className="text-[#5A6376] font-semibold hidden sm:inline">{totalVotes > 0 ? `${totalVotes} voto(s) nos argumentos` : "Termômetro calculado pelos votos reais"}</span>
            <span style={{ color: T.contra }}>{100 - favorPct}% • CONTRA</span>
          </div>
          <div className="h-2.5 rounded-full overflow-hidden flex" style={{ background: "#0B0E15" }}>
            <motion.div className="h-full" style={{ background: "linear-gradient(90deg,#3D5BEE,#6C8CFF)" }} initial={false} animate={{ width: `${favorPct}%` }} transition={{ duration: 0.6 }} />
            <div className="h-full flex-1" style={{ background: "linear-gradient(90deg,#F5A524,#E08E0B)" }} />
          </div>
        </div>
      </Card>

      <div className="grid lg:grid-cols-[1fr_280px_1fr] gap-4">
        <Card className="p-4 sm:p-5" style={{ borderColor: `${T.accent}33` }}>
          <div className="flex items-center justify-between mb-4 gap-2">
            <div className="flex items-center gap-2 min-w-0">
              <span className="w-8 h-8 rounded-lg flex items-center justify-center shrink-0" style={{ background: `${T.accent}22`, color: T.accentSoft }}><IconUp size={14} /></span>
              <div className="min-w-0"><div className="text-sm font-extrabold truncate" style={{ color: T.accentSoft }}>A FAVOR</div><div className="text-[10px] text-[#5A6376] font-semibold truncate">{deb.favorTeam}</div></div>
            </div>
            <Pill color={T.accentSoft}>{favorVotes} apoios</Pill>
          </div>
          <div className="space-y-3">
            {favorArgs.length === 0 && <p className="text-[11px] text-[#5A6376] text-center py-6 leading-relaxed">Nenhum argumento ainda. Publique o primeiro abaixo.</p>}
            {favorArgs.map((a) => <ArgCard key={a.id} a={a} side="favor" me={me} onVote={act.voteArg} />)}
          </div>
        </Card>

        <div className="space-y-4 order-first lg:order-none">
          <Card className="p-4">
            <div className="flex items-center gap-2 mb-3 text-sm font-bold"><IconShield size={15} className="text-[#34D399]" /> Regras de convivência</div>
            <ul className="space-y-2">
              {["Ataque o argumento, nunca a pessoa.", "Cite fontes: dados valem mais que opiniões.", "Respeite o tempo de fala de cada lado.", "Sem interrupções — aguarde sua réplica.", "Linguagem ofensiva gera advertência e remoção."].map((r, i) => (
                <li key={r} className="flex gap-2 text-[11px] text-[#B8C0D0] leading-relaxed">
                  <span className="w-4 h-4 rounded-md flex items-center justify-center text-[9px] font-extrabold shrink-0 mt-0.5" style={{ background: T.accentDim, color: T.accentSoft }}>{i + 1}</span>{r}
                </li>
              ))}
            </ul>
          </Card>
          <Card className="p-4 text-center">
            <div className="text-[10px] font-bold tracking-widest uppercase text-[#5A6376] mb-1">Argumentos publicados</div>
            <div className="flex items-center justify-center gap-3 text-xl font-extrabold" style={{ fontVariantNumeric: "tabular-nums" }}>
              <span style={{ color: T.accentSoft }}>{favorArgs.length}</span>
              <span style={{ color: "#39415A" }}>×</span>
              <span style={{ color: T.contra }}>{contraArgs.length}</span>
            </div>
          </Card>
        </div>

        <Card className="p-4 sm:p-5" style={{ borderColor: `${T.contra}33` }}>
          <div className="flex items-center justify-between mb-4 gap-2">
            <div className="flex items-center gap-2 min-w-0">
              <span className="w-8 h-8 rounded-lg flex items-center justify-center shrink-0" style={{ background: `${T.contra}1F`, color: T.contra }}><IconX size={14} /></span>
              <div className="min-w-0"><div className="text-sm font-extrabold truncate" style={{ color: T.contra }}>CONTRA</div><div className="text-[10px] text-[#5A6376] font-semibold truncate">{deb.contraTeam}</div></div>
            </div>
            <Pill color={T.contra}>{contraVotes} apoios</Pill>
          </div>
          <div className="space-y-3">
            {contraArgs.length === 0 && <p className="text-[11px] text-[#5A6376] text-center py-6 leading-relaxed">Nenhum argumento ainda. Publique o primeiro abaixo.</p>}
            {contraArgs.map((a) => <ArgCard key={a.id} a={a} side="contra" me={me} onVote={act.voteArg} />)}
          </div>
        </Card>
      </div>

      <Card className="p-4 sm:p-5">
        <div className="flex items-center justify-between mb-3 flex-wrap gap-3">
          <span className="text-sm font-bold flex items-center gap-2"><IconMsg size={14} className="text-[#6C8CFF]" /> Publicar argumento</span>
          <div className="flex rounded-lg p-1 gap-1" style={{ background: "#0B0E15", border: `1px solid ${T.border}` }}>
            <button onClick={() => setArgSide("favor")} className="px-3 py-1.5 rounded-md text-[11px] font-bold transition-all" style={argSide === "favor" ? { background: T.accent, color: "#fff" } : { color: T.muted }}>A FAVOR</button>
            <button onClick={() => setArgSide("contra")} className="px-3 py-1.5 rounded-md text-[11px] font-bold transition-all" style={argSide === "contra" ? { background: T.contra, color: "#0B0E15" } : { color: T.muted }}>CONTRA</button>
          </div>
        </div>
        <div className="flex flex-col sm:flex-row gap-2">
          <input value={newArg} onChange={(e) => setNewArg(e.target.value)} disabled={iAmMuted}
            onKeyDown={(e) => { if (e.key === "Enter" && newArg.trim() && !iAmMuted) { act.addArg(argSide, newArg.trim()); setNewArg(""); } }}
            placeholder={iAmMuted ? "Você foi silenciado pela moderação" : "Escreva um argumento fundamentado, com dados ou exemplos…"}
            className="flex-1 rounded-xl px-4 py-3 text-xs border outline-none focus:border-[#4D6BFE] placeholder:text-[#5A6376] disabled:opacity-50"
            style={{ background: "#0B0E15", borderColor: T.border, color: T.text }} />
          <Btn className="shrink-0" disabled={iAmMuted || !newArg.trim()} onClick={() => { act.addArg(argSide, newArg.trim()); setNewArg(""); }}>
            <IconSend size={13} /> Publicar (+10 XP)
          </Btn>
        </div>
      </Card>
    </div>
  );
};

/* ============================================================
   PÁGINA: PERGUNTAS & RESPOSTAS
   ============================================================ */
const QnAPage = ({ data, me, isStaff, act, iAmMuted }) => {
  const [text, setText] = useState("");
  const [filter, setFilter] = useState("todas");
  const [answering, setAnswering] = useState(null);
  const [ansText, setAnsText] = useState("");

  const statusMeta = { "ao-vivo": { label: "AO VIVO", color: "#FF8A80" }, pendente: { label: "NA MODERAÇÃO", color: "#F5A524" }, respondida: { label: "RESPONDIDA", color: "#34D399" } };
  const list = (filter === "todas" ? data.questions : data.questions.filter((q) => q.status === filter)).slice().sort((a, b) => voteCount(b.voters) - voteCount(a.voters));

  return (
    <div className="max-w-[820px] mx-auto space-y-4">
      <Card className="p-4 sm:p-5" style={{ borderColor: `${T.accent}33`, background: "linear-gradient(180deg, rgba(77,107,254,.07), #11151F 50%)" }}>
        <div className="text-sm font-bold mb-2 flex items-center gap-2"><IconHelp size={15} className="text-[#6C8CFF]" /> {isStaff ? "Publicar pergunta" : "Faça sua pergunta"}</div>
        <div className="flex flex-col sm:flex-row gap-2">
          <input value={text} onChange={(e) => setText(e.target.value)} disabled={iAmMuted}
            onKeyDown={(e) => { if (e.key === "Enter" && text.trim() && !iAmMuted) { act.addQuestion(text); setText(""); } }}
            placeholder={iAmMuted ? "Você foi silenciado pela moderação" : "Escreva uma pergunta clara e objetiva…"}
            className="flex-1 rounded-xl px-4 py-3 text-sm border outline-none focus:border-[#4D6BFE] placeholder:text-[#5A6376] disabled:opacity-50"
            style={{ background: "#0B0E15", borderColor: T.border, color: T.text }} />
          <Btn className="shrink-0" disabled={iAmMuted || !text.trim()} onClick={() => { act.addQuestion(text); setText(""); }}><IconSend size={13} /> Enviar</Btn>
        </div>
        <p className="text-[10px] text-[#5A6376] mt-2">
          {isStaff ? "Como docente, sua pergunta entra direto na fila ao vivo." : "Sua pergunta passa pela moderação do professor e aparece para toda a sala (+5 XP). Qualquer participante pode responder (+8 XP)."}
        </p>
      </Card>

      <div className="flex gap-2 flex-wrap">
        {[["todas", "Todas"], ["ao-vivo", "Ao vivo"], ["pendente", "Na moderação"], ["respondida", "Respondidas"]].map(([k, l]) => (
          <button key={k} onClick={() => setFilter(k)} className="px-3.5 py-1.5 rounded-full text-[11px] font-bold border transition-all"
            style={filter === k ? { background: T.accent, borderColor: T.accent, color: "#fff" } : { borderColor: T.border, background: T.surface, color: T.muted }}>
            {l} ({k === "todas" ? data.questions.length : data.questions.filter((q) => q.status === k).length})
          </button>
        ))}
      </div>

      {list.length === 0 ? (
        <Card><Empty icon={<IconHelp size={24} />} title="Nenhuma pergunta aqui"
          sub="As perguntas enviadas por qualquer dispositivo da sala aparecem aqui em tempo real, com votos e respostas." /></Card>
      ) : (
        <div className="space-y-3">
          {list.map((q) => {
            const on = !!q.voters?.[me.id];
            return (
              <Card key={q.id} className="p-4 sm:p-5">
                <div className="flex gap-3 sm:gap-4">
                  <button onClick={() => act.voteQuestion(q.id, !on)}
                    className="flex flex-col items-center gap-1 px-2.5 py-3 rounded-xl transition-all active:scale-95 shrink-0 self-start"
                    style={on ? { background: T.accent, color: "#fff" } : { background: "#0B0E15", color: T.muted, border: `1px solid ${T.border}` }}>
                    <IconUp size={15} />
                    <span className="text-sm font-extrabold" style={{ fontVariantNumeric: "tabular-nums" }}>{voteCount(q.voters)}</span>
                  </button>
                  <div className="flex-1 min-w-0">
                    <div className="flex items-center gap-2 mb-1.5 flex-wrap">
                      <Pill color={statusMeta[q.status]?.color || T.muted}>{statusMeta[q.status]?.label || q.status}</Pill>
                      <span className="text-[10px] text-[#5A6376] font-semibold">{q.author}{q.turma ? ` • ${q.turma}` : ""} • {fmtWhen(q.ts)}</span>
                      {isStaff && (
                        <span className="ml-auto flex gap-1.5">
                          {q.status === "pendente" && <button onClick={() => act.qStatus(q.id, "ao-vivo")} className="text-[10px] font-bold px-2 py-1 rounded-lg border transition-colors" style={{ borderColor: `${T.ok}55`, color: T.ok }}>Aprovar</button>}
                          {q.status !== "respondida" && <button onClick={() => act.qStatus(q.id, "respondida")} className="text-[10px] font-bold px-2 py-1 rounded-lg border transition-colors" style={{ borderColor: `${T.accent}55`, color: T.accentSoft }}>Responderam</button>}
                          <button onClick={() => act.qRemove(q.id)} className="text-[10px] font-bold px-2 py-1 rounded-lg border transition-colors" style={{ borderColor: `${T.danger}55`, color: "#FF8A80" }}>Remover</button>
                        </span>
                      )}
                    </div>
                    <p className="text-sm font-semibold leading-relaxed">{q.text}</p>

                    {q.answers.length > 0 && (
                      <div className="mt-3 space-y-2">
                        {q.answers.map((an) => {
                          const aon = !!an.voters?.[me.id];
                          return (
                            <div key={an.id} className="p-3 rounded-xl border-l-2" style={{ borderColor: T.accent, background: T.accentDim }}>
                              <div className="flex items-center gap-2 mb-1">
                                <span className="text-[10px] font-bold text-[#93AAFF]">{an.author}{an.authorId === me.id ? " (você)" : ""}</span>
                                <span className="text-[9px] text-[#5A6376]">{fmtWhen(an.ts)}</span>
                                <button onClick={() => act.voteAnswer(q.id, an.id, !aon)}
                                  className="ml-auto flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-lg transition-all active:scale-95"
                                  style={aon ? { background: T.accent, color: "#fff" } : { background: "#0B0E15", color: T.muted }}>
                                  <IconUp size={10} /> {voteCount(an.voters)}
                                </button>
                              </div>
                              <p className="text-xs text-[#C6CDDB] leading-relaxed">{an.text}</p>
                            </div>
                          );
                        })}
                      </div>
                    )}

                    <div className="mt-3">
                      {answering === q.id ? (
                        <div className="flex gap-2">
                          <input autoFocus value={ansText} onChange={(e) => setAnsText(e.target.value)} disabled={iAmMuted}
                            onKeyDown={(e) => { if (e.key === "Enter" && ansText.trim()) { act.answerQuestion(q.id, ansText.trim()); setAnsText(""); setAnswering(null); } if (e.key === "Escape") setAnswering(null); }}
                            placeholder="Escreva sua resposta…"
                            className="flex-1 rounded-xl px-3.5 py-2 text-xs border outline-none focus:border-[#4D6BFE] placeholder:text-[#5A6376]"
                            style={{ background: "#0B0E15", borderColor: T.border, color: T.text }} />
                          <Btn size="sm" disabled={iAmMuted || !ansText.trim()} onClick={() => { act.answerQuestion(q.id, ansText.trim()); setAnsText(""); setAnswering(null); }}><IconSend size={12} /></Btn>
                        </div>
                      ) : (
                        <button onClick={() => setAnswering(q.id)} disabled={iAmMuted}
                          className="text-[11px] font-bold text-[#6C8CFF] hover:text-[#93AAFF] transition-colors disabled:opacity-40 flex items-center gap-1.5">
                          <IconMsg size={12} /> Responder (+8 XP)
                        </button>
                      )}
                    </div>
                  </div>
                </div>
              </Card>
            );
          })}
        </div>
      )}
    </div>
  );
};

/* ============================================================
   PÁGINA: ENQUETES
   ============================================================ */
const PollsPage = ({ data, me, act, notify, isStaff }) => {
  const [question, setQuestion] = useState("");
  const [opts, setOpts] = useState(["", ""]);
  const canCreate = question.trim().length > 0 && opts.filter((o) => o.trim()).length >= 2;

  const create = () => {
    if (!canCreate) return;
    act.addPoll(question.trim(), opts.filter((o) => o.trim()).map((o) => o.trim()));
    setQuestion(""); setOpts(["", ""]);
  };

  return (
    <div className="max-w-[820px] mx-auto space-y-4">
      <Card className="p-4 sm:p-5">
        <SectionTitle icon={<IconPlus size={18} />} title="Criar enquete" sub="Qualquer participante pode criar; os votos chegam em tempo real para toda a sala" />
        <div className="space-y-2.5">
          <Input value={question} onChange={setQuestion} placeholder="Pergunta da enquete" />
          {opts.map((o, i) => (
            <div key={i} className="flex gap-2">
              <Input value={o} onChange={(v) => setOpts(opts.map((x, j) => (j === i ? v : x)))} placeholder={`Opção ${i + 1}`} />
              {opts.length > 2 && (
                <button onClick={() => setOpts(opts.filter((_, j) => j !== i))} className="px-3 rounded-xl border text-[#5A6376] hover:text-[#FF8A80] transition-colors shrink-0" style={{ borderColor: T.border }}><IconTrash size={14} /></button>
              )}
            </div>
          ))}
          <div className="flex gap-2 flex-wrap">
            {opts.length < 5 && <Btn size="sm" variant="ghost" onClick={() => setOpts([...opts, ""])}><IconPlus size={12} /> Adicionar opção</Btn>}
            <Btn size="sm" className="ml-auto" disabled={!canCreate} onClick={create}><IconChart size={13} /> Publicar enquete</Btn>
          </div>
        </div>
      </Card>

      {data.polls.length === 0 ? (
        <Card><Empty icon={<IconChart size={24} />} title="Nenhuma enquete criada"
          sub="Crie a primeira enquete acima. Ela aparecerá aqui e poderá ser aberta durante a palestra para todos os dispositivos." /></Card>
      ) : (
        data.polls.map((p) => {
          const total = p.options.reduce((acc, o) => acc + voteCount(o.voters), 0);
          const iVoted = p.options.some((o) => o.voters?.[me.id]);
          return (
            <Card key={p.id} className="p-4 sm:p-6" style={!p.closed ? { borderColor: `${T.accent}44` } : {}}>
              <div className="flex items-center justify-between mb-3 gap-2 flex-wrap">
                <div className="flex items-center gap-2 flex-wrap">
                  {p.closed ? <Pill color={T.muted}>ENCERRADA</Pill> : <Pill color="#FF8A80" bg="#F16A5E1A"><span className="w-1.5 h-1.5 rounded-full bg-[#F16A5E] animate-pulse" />AO VIVO</Pill>}
                  <span className="text-[11px] text-[#5A6376] font-semibold flex items-center gap-1"><IconUsers size={11} /> {total} voto(s)</span>
                  <span className="text-[10px] text-[#3D465C]">por {p.hostName} • {fmtWhen(p.ts)}</span>
                </div>
                {(isStaff || p.hostId === me.id) && !p.closed && (
                  <Btn size="sm" variant="ghost" onClick={() => act.closePoll(p.id)}><IconCheck size={12} /> Encerrar</Btn>
                )}
              </div>
              <h3 className="text-sm sm:text-base font-extrabold tracking-tight mb-4">{p.question}</h3>
              <div className="space-y-2.5">
                {p.options.map((o, i) => {
                  const votes = voteCount(o.voters);
                  const pct = total > 0 ? Math.round((votes / total) * 100) : 0;
                  const chosen = !!o.voters?.[me.id];
                  const leading = votes > 0 && votes === Math.max(...p.options.map((x) => voteCount(x.voters)));
                  return (
                    <button key={o.label + i} onClick={() => { if (!p.closed && !iVoted) { act.votePoll(p.id, i); notify("Voto registrado (+2 XP)", "xp"); } }}
                      disabled={p.closed || iVoted}
                      className="w-full relative rounded-xl border overflow-hidden text-left transition-all disabled:cursor-default"
                      style={{ borderColor: chosen ? T.accent : T.border, background: T.surface2 }}>
                      <motion.div className="absolute inset-y-0 left-0" initial={false} animate={{ width: `${pct}%` }} transition={{ duration: 0.6 }}
                        style={{ background: chosen ? "rgba(77,107,254,.3)" : leading ? "rgba(77,107,254,.16)" : "rgba(139,148,168,.07)" }} />
                      <div className="relative flex items-center justify-between px-4 py-3 gap-3">
                        <span className="text-xs sm:text-sm font-semibold flex items-center gap-2 min-w-0">
                          {chosen && <IconCheck size={13} className="text-[#6C8CFF] shrink-0" />}
                          <span className="truncate">{o.label}</span>
                          {leading && iVoted && <span className="text-[9px] font-extrabold px-1.5 py-0.5 rounded-md shrink-0" style={{ background: `${T.accent}26`, color: T.accentSoft }}>LÍDER</span>}
                        </span>
                        <span className="text-sm font-extrabold shrink-0" style={{ color: chosen ? T.accentSoft : T.muted, fontVariantNumeric: "tabular-nums" }}>{iVoted || p.closed ? `${pct}%` : "—"}</span>
                      </div>
                    </button>
                  );
                })}
              </div>
            </Card>
          );
        })
      )}
    </div>
  );
};

