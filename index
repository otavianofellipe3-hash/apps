              <label className="text-[10px] font-bold tracking-widest uppercase text-[#5A6376] mb-2 block">Entrar em sala existente</label>
              <div className="flex gap-2">
                <input className={inputCls} style={inputStyle} placeholder="AGX-XXXX" value={joinCode} onChange={(e) => setJoinCode(e.target.value.toUpperCase().slice(0, 12))}
                  onKeyDown={(e) => { if (e.key === "Enter" && joinCode.trim().length >= 4) onJoin(joinCode.trim()); }} />
                <Btn variant="ghost" onClick={() => { if (joinCode.trim().length < 4) { setErr("Digite um código válido."); return; } setErr(""); onJoin(joinCode.trim()); }}>
                  <IconArrow size={14} /> Entrar
                </Btn>
              </div>
              {err && <div className="text-[11px] text-[#FF8A80] font-semibold mt-2">{err}</div>}
            </div>
          </div>
        </Card>
      </motion.div>
    </div>
  );
};

/* ============================================================
   APP SINCRONIZADO
   ============================================================ */
function SyncedApp({ session, onLogout, onChangeRoom }) {
  const room = session.room;
  const me = session;
  const isStaff = me.role === "teacher" || me.role === "coordinator";

  const stored = useRef(loadRoomState(room));
  const [data, setData] = useState(() => (stored.current ? stored.current.data : emptyData()));
  const revRef = useRef(stored.current ? stored.current.rev || 0 : 0);
  const dataRef = useRef(data); dataRef.current = data;

  const [tab, setTab] = useState("visao");
  const [toast, setToast] = useState(null);
  const [moreOpen, setMoreOpen] = useState(false);
  const [userMenu, setUserMenu] = useState(false);
  const [myXp, setMyXp] = useState(() => loadMyXp(me.id));
  const myXpRef = useRef(myXp); myXpRef.current = myXp;

  const notify = useCallback((msg, tone = "ok") => {
    setToast({ msg, tone, id: Date.now() });
    setTimeout(() => setToast(null), 2600);
  }, []);

  const net = useRoomSync(room, me,
    useCallback((m) => {
      if (m.type === "snap") {
        const p = m.payload || {};
        if (p.rev > revRef.current) { revRef.current = p.rev; setData(p.data || emptyData()); }
        return;
      }
      revRef.current += 1;
      setData((prev) => applyEvent(prev, m));
    }, []),
    useCallback(() => ({ data: dataRef.current, rev: revRef.current }), [])
  );

  const send = useCallback((type, payload) => {
    const m = { id: uid(), type, payload };
    revRef.current += 1;
    setData((prev) => applyEvent(prev, m));
    net.publish(m);
  }, [net]);

  useEffect(() => { saveRoomState(room, data, revRef.current); }, [data, room]);

  /* XP próprio: publica no quadro ao entrar */
  useEffect(() => {
    const t = setTimeout(() => {
      send("xp_set", { userId: me.id, name: me.name, turma: me.turma || "", xp: myXpRef.current });
    }, 1200);
    return () => clearTimeout(t);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const gainXp = useCallback((n) => {
    setMyXp((prev) => {
      const nx = prev + n;
      saveMyXp(me.id, nx);
      send("xp_set", { userId: me.id, name: me.name, turma: me.turma || "", xp: nx });
      return nx;
    });
  }, [me, send]);

  const iAmMuted = !!data.mutes[me.id];

  /* ---------- Ações do usuário ---------- */
  const act = {
    startLecture: (lecture) => send("lecture_start", { lecture: { ...lecture, id: uid(), hostId: me.id, hostName: me.name, startedAt: Date.now(), live: true } }),
    endLecture: () => send("lecture_end", {}),
    startDebate: (deb) => send("debate_start", { debate: { ...deb, id: uid(), hostId: me.id, hostName: me.name, round: 1, startedAt: Date.now() } }),
    extendDebate: (mins) => { if (data.debate) send("debate_extend", { endsAt: Date.now() + mins * 60000, round: (data.debate.round || 1) + 1 }); },
    endDebate: () => send("debate_end", {}),
    addArg: (side, text) => {
      send("arg_add", { arg: { id: uid(), side, author: me.name, authorId: me.id, text, voters: { [me.id]: 1 }, ts: Date.now() } });
      gainXp(10); notify("Argumento publicado (+10 XP)", "xp");
    },
    voteArg: (argId, on) => send("arg_vote", { argId, userId: me.id, on }),
    addQuestion: (text) => {
      const q = { id: uid(), author: me.name, authorId: me.id, turma: me.turma || (isStaff ? "Docente" : ""), text, status: isStaff ? "ao-vivo" : "pendente", voters: { [me.id]: 1 }, votes: undefined, answers: [], ts: Date.now() };
      send("q_add", { q });
      gainXp(5);
      notify(isStaff ? "Pergunta publicada." : "Pergunta enviada para a moderação (+5 XP)", "xp");
    },
    voteQuestion: (qid, on) => send("q_vote", { qid, userId: me.id, on }),
    answerQuestion: (qid, text) => {
      send("q_answer", { qid, answer: { id: uid(), author: me.name, authorId: me.id, text, voters: { [me.id]: 1 }, ts: Date.now() } });
      gainXp(8); notify("Resposta publicada (+8 XP)", "xp");
    },
    voteAnswer: (qid, aid, on) => send("a_vote", { qid, aid, userId: me.id, on }),
    qStatus: (qid, status) => {
      send("q_status", { qid, status });
      send("mod_log_add", { entry: { id: uid(), action: status === "ao-vivo" ? "Pergunta aprovada" : "Pergunta marcada como respondida", who: me.name, ts: Date.now(), tone: "ok" } });
      notify("Ação de moderação registrada.");
    },
    qRemove: (qid) => {
      send("q_remove", { qid });
      send("mod_log_add", { entry: { id: uid(), action: "Pergunta removida", who: me.name, ts: Date.now(), tone: "bad" } });
      notify("Pergunta removida.", "warn");
    },
    addPoll: (question, options) => {
      send("poll_add", { poll: { id: uid(), question, options: options.map((label) => ({ label, voters: {} })), hostName: me.name, hostId: me.id, ts: Date.now(), closed: false } });
      notify("Enquete criada e enviada para todos os dispositivos.");
    },
    votePoll: (pollId, idx) => { send("poll_vote", { pollId, idx, userId: me.id }); gainXp(2); },
    closePoll: (pollId) => send("poll_close", { pollId }),
    removePoll: (pollId) => send("poll_remove", { pollId }),
    sendChat: (text) => {
      send("chat_add", { msg: { id: uid(), author: me.name, authorId: me.id, text, ts: Date.now() } });
      const nx = myXpRef.current + 1; saveMyXp(me.id, nx); setMyXp(nx);
      send("xp_set", { userId: me.id, name: me.name, turma: me.turma || "", xp: nx });
    },
    removeChat: (msgId) => {
      send("chat_remove", { msgId });
      send("mod_log_add", { entry: { id: uid(), action: "Mensagem de chat removida", who: me.name, ts: Date.now(), tone: "bad" } });
    },
    react: (key, on) => send("react", { key, userId: me.id, on }),
    reportChat: (m) => {
      send("report_add", { report: { id: uid(), chatId: m.id, text: m.text, author: m.author, authorId: m.authorId, reporter: me.name, ts: Date.now(), handled: null } });
      notify("Denúncia enviada à moderação.");
    },
    resolveReport: (reportId, action, extra) => {
      send("report_resolve", { reportId, action });
      if (action === "removido" && extra?.chatId) { send("chat_remove", { msgId: extra.chatId }); }
      if (action === "silenciado" && extra?.authorId) { send("mute_set", { userId: extra.authorId, muted: true, by: me.name }); }
      send("mod_log_add", { entry: { id: uid(), action: `Denúncia resolvida: ${action}`, who: me.name, ts: Date.now(), tone: action === "mantido" ? "ok" : "warn" } });
      notify(`Denúncia resolvida (${action}).`);
    },
    toggleMute: (userId, name, muted) => {
      send("mute_set", { userId, muted, by: me.name });
      send("mod_log_add", { entry: { id: uid(), action: muted ? `${name} silenciado(a)` : `${name} liberado(a) para falar`, who: me.name, ts: Date.now(), tone: muted ? "warn" : "ok" } });
      notify(muted ? `${name} foi silenciado(a).` : `${name} pode participar novamente.`, muted ? "warn" : "ok");
    },
  };

  /* ---------- Navegação ---------- */
  const mainTabs = [
    { id: "visao", label: "Visão", icon: <IconGrid size={17} /> },
    { id: "palestra", label: "Palestra", icon: <IconMonitor size={17} /> },
    { id: "arena", label: "Arena", icon: <IconScale size={17} /> },
    { id: "qa", label: "Perguntas", icon: <IconHelp size={17} /> },
    { id: "enquetes", label: "Enquetes", icon: <IconChart size={17} /> },
  ];
  const moreTabs = [
    { id: "pontos", label: "Pontuação", icon: <IconAward size={17} /> },
    ...(isStaff ? [{ id: "moderacao", label: "Moderação", icon: <IconShield size={17} /> }] : []),
    { id: "planejamento", label: "Planejamento", icon: <IconLayers size={17} /> },
    { id: "design", label: "Design System", icon: <IconDroplet size={17} /> },
  ];
  const allTabs = [...mainTabs, ...moreTabs];
  const pendingCount = isStaff ? data.questions.filter((q) => q.status === "pendente").length + data.reports.filter((r) => !r.handled).length : 0;

  const titles = {
    visao: ["Visão Geral", `Sala ${room} • ${net.participantCount} participante(s) conectado(s)`],
    palestra: ["Palestra ao Vivo", data.lecture ? data.lecture.title : "Nenhuma transmissão ativa"],
    arena: ["Arena de Debate", data.debate ? data.debate.motion : "Nenhum debate ativo"],
    qa: ["Perguntas & Respostas", "Envie, responda e vote — sincronizado em tempo real"],
    enquetes: ["Enquetes ao Vivo", "Crie e vote; os resultados aparecem para toda a sala"],
    moderacao: ["Central de Moderação", "Fila real de perguntas, denúncias e controles"],
    pontos: ["Pontuação & Ranking", "XP real gerado pela participação da sala"],
    planejamento: ["Planejamento do Projeto", "Funcionalidades • Fluxos • Arquitetura"],
    design: ["Design System", "Cores • Tipografia • Componentes"],
  };

  const syncChip = {
    online: { color: T.ok, label: "Tempo real ativo" },
    reconnecting: { color: "#F5A524", label: "Reconectando…" },
