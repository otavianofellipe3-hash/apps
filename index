              <div>
                <label className={labelCls}>Senha</label>
                <div className="relative">
                  <input className={`${inputCls} pr-11`} style={inputStyle} type={showPass ? "text" : "password"} value={pass} onChange={(e) => setPass(e.target.value)} placeholder="Sua senha" autoComplete="current-password" required />
