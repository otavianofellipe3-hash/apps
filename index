/* ============================================================
   PÁGINA: PONTUAÇÃO (XP real)
   ============================================================ */
const ScoringPage = ({ data, me, myXp }) => {
  const board = useMemo(() => {
    const map = { ...data.xpBoard };
    map[me.id] = { userId: me.id, name: me.name, turma: me.turma || "", xp: Math.max(myXp, map[me.id]?.xp || 0) };
    return Object.values(map).sort((a, b) => b.xp - a.xp);
  }, [data.xpBoard, me, myXp]);

  const myRank = board.findIndex((b) => b.userId === me.id) + 1;
  const lvl = levelOf(myXp);
  const podium = board.slice(0, 3);
  const medal = ["#F5A524", "#B8C0D0", "#C98A5E"];
  const rules = [
    { action: "Pergunta enviada", xp: "+5", icon: <IconHelp size={13} /> },
    { action: "Resposta publicada", xp: "+8", icon: <IconMsg size={13} /> },
    { action: "Argumento na arena", xp: "+10", icon: <IconScale size={13} /> },
    { action: "Voto em enquete", xp: "+2", icon: <IconChart size={13} /> },
    { action: "Mensagem no chat", xp: "+1", icon: <IconSend size={13} /> },
    { action: "Advertência da moderação", xp: "−20", icon: <IconFlag size={13} />, bad: true },
  ];

  return (
    <div className="max-w-[920px] mx-auto space-y-4">
      {podium.length > 0 && (
        <div className="grid gap-3 items-end" style={{ gridTemplateColumns: `repeat(${Math.min(3, podium.length)}, minmax(0,1fr))` }}>
          {Array.from({ length: Math.min(3, podium.length) }).map((_, col) => {
            const order = [1, 0, 2];
            const s = podium[order[col]];
            if (!s) return null;
            const idx = order[col];
            const heights = [150, 116, 96];
            return (
              <div key={s.userId} className="rounded-2xl border p-4 text-center relative overflow-hidden"
                style={{ height: heights[idx] + 84, borderColor: idx === 0 ? `${medal[idx]}66` : T.border, background: idx === 0 ? `linear-gradient(180deg, ${medal[idx]}14, ${T.surface})` : T.surface }}>
                <span className="absolute top-3 left-1/2 -translate-x-1/2 text-[10px] font-extrabold tracking-widest" style={{ color: medal[idx] }}>{idx + 1}º LUGAR</span>
                <div className="mt-6 flex justify-center"><Avatar name={s.name} size={idx === 0 ? 56 : 44} ring={idx === 0} /></div>
                <div className="text-xs font-bold mt-3 leading-tight px-1 truncate">{s.name}{s.userId === me.id ? " (você)" : ""}</div>
                {s.turma && <div className="text-[10px] text-[#5A6376]">{s.turma}</div>}
                <div className="text-lg font-extrabold mt-1" style={{ color: idx === 0 ? medal[0] : T.accentSoft, fontVariantNumeric: "tabular-nums" }}>{s.xp} XP</div>
              </div>
            );
          })}
        </div>
      )}

      <div className="grid lg:grid-cols-3 gap-4">
        <Card className="p-4 sm:p-5 lg:col-span-2">
          <SectionTitle icon={<IconAward size={18} />} title="Ranking da sala" sub="Pontuação real gerada pela participação" />
          {board.length === 0 ? (
            <Empty icon={<IconAward size={22} />} title="Ranking vazio" sub="Participe de palestras e debates para gerar seus primeiros pontos." />
          ) : (
            <div className="space-y-1.5">
              {board.map((s, i) => (
                <div key={s.userId} className="flex items-center gap-3 p-3 rounded-xl border"
                  style={s.userId === me.id ? { borderColor: `${T.accent}55`, background: T.accentDim } : { borderColor: T.border, background: T.surface2 }}>
                  <span className="w-6 text-center text-xs font-extrabold" style={{ color: i < 3 ? medal[i] : "#5A6376" }}>{i + 1}</span>
                  <Avatar name={s.name} size={32} />
                  <div className="flex-1 min-w-0">
                    <div className="text-sm font-semibold truncate">{s.name}{s.userId === me.id ? " (você)" : ""}</div>
                    <div className="text-[10px] text-[#5A6376]">{s.turma || (s.userId === me.id ? (me.role === "student" ? "Estudante" : "Docente") : "")}</div>
                  </div>
                  <div className="text-sm font-extrabold text-[#93AAFF] shrink-0" style={{ fontVariantNumeric: "tabular-nums" }}>{s.xp}</div>
                </div>
              ))}
            </div>
          )}
        </Card>

        <div className="space-y-4">
          <Card className="p-4 sm:p-5" style={{ borderColor: `${T.accent}44`, background: "linear-gradient(180deg, rgba(77,107,254,.08), #11151F 55%)" }}>
            <div className="text-xs font-bold tracking-widest uppercase text-[#5A6376] mb-1">Seu progresso</div>
            <div className="text-3xl font-extrabold" style={{ fontVariantNumeric: "tabular-nums" }}>{myXp} <span className="text-sm text-[#8B94A8] font-bold">XP</span></div>
            <div className="text-[11px] font-bold text-[#93AAFF] mt-0.5">{lvl.name} • {myRank > 0 ? `${myRank}º na sala` : ""}</div>
            {lvl.next && (
              <>
                <div className="h-2 rounded-full mt-3 overflow-hidden" style={{ background: "#0B0E15" }}>
                  <motion.div className="h-full rounded-full" style={{ background: "linear-gradient(90deg,#4D6BFE,#6C8CFF)" }}
                    initial={false} animate={{ width: `${Math.min(100, Math.round(((myXp - lvl.min) / (lvl.next.min - lvl.min)) * 100))}%` }} transition={{ duration: 0.8 }} />
                </div>
                <div className="text-[10px] text-[#8B94A8] mt-2">Faltam <span className="text-[#93AAFF] font-bold">{lvl.next.min - myXp} XP</span> para <span className="font-bold">{lvl.next.name}</span></div>
              </>
            )}
          </Card>
          <Card className="p-4 sm:p-5">
            <div className="text-sm font-bold mb-3 flex items-center gap-2"><IconZap size={14} className="text-[#6C8CFF]" /> Como ganhar pontos</div>
            <div className="space-y-2">
              {rules.map((r) => (
                <div key={r.action} className="flex items-center gap-2.5 text-[11px]">
                  <span className="w-7 h-7 rounded-lg flex items-center justify-center shrink-0" style={{ background: r.bad ? "#F16A5E1A" : T.accentDim, color: r.bad ? "#FF8A80" : T.accentSoft }}>{r.icon}</span>
                  <span className="flex-1 text-[#B8C0D0] leading-snug">{r.action}</span>
                  <span className="font-extrabold shrink-0" style={{ color: r.bad ? "#FF8A80" : "#34D399" }}>{r.xp}</span>
                </div>
              ))}
            </div>
          </Card>
        </div>
      </div>
    </div>
  );
};

