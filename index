const AuthScreen = ({ onAuth, googleReturn }) => {
  const [mode, setMode] = useState(googleReturn ? "register" : "login");
  const [name, setName] = useState("");
  const [email, setEmail] = useState("");
  const [pass, setPass] = useState("");
  const [pass2, setPass2] = useState("");
  const [role, setRole] = useState("student");
  const [turma, setTurma] = useState("");
  const [showPass, setShowPass] = useState(false);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");

  useEffect(() => {
    if (googleReturn) {
      setNotice("Retorno do Google concluído. Complete seu cadastro para entrar no ÁgoraEDU com a conta Google conectada.");
    }
  }, [googleReturn]);

  const strength = useMemo(() => {
    let sc = 0;
    if (pass.length >= 6) sc++;
    if (pass.length >= 10) sc++;
    if (/[0-9]/.test(pass)) sc++;
    if (/[^A-Za-z0-9]/.test(pass)) sc++;
    return sc;
  }, [pass]);

  const validateEmail = (e) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(e);

  const handleLogin = (e) => {
    e.preventDefault();
    setError("");
    const users = loadUsers();
    const u = users.find((x) => x.email.toLowerCase() === email.trim().toLowerCase());
    if (!u || u.pass !== pass) { setError("E-mail ou senha incorretos. Verifique e tente novamente."); return; }
    onAuth({ ...u, viaGoogleReturn: false });
  };

  const handleRegister = (e) => {
    e.preventDefault();
    setError("");
    if (name.trim().length < 3) { setError("Informe seu nome completo (mínimo 3 caracteres)."); return; }
    if (!validateEmail(email)) { setError("Informe um e-mail válido."); return; }
    const users = loadUsers();
    if (users.some((x) => x.email.toLowerCase() === email.trim().toLowerCase())) { setError("Já existe uma conta com este e-mail. Faça login."); return; }
    if (pass.length < 6) { setError("A senha deve ter pelo menos 6 caracteres."); return; }
    if (pass !== pass2) { setError("As senhas não coincidem."); return; }
    const u = { id: uid(), name: name.trim(), email: email.trim(), pass, role, turma: turma.trim(), google: !!googleReturn, createdAt: Date.now() };
    saveUsers([...users, u]);
    onAuth(u);
  };

  const googleSignIn = () => {
    const back = `${window.location.origin}${window.location.pathname}?gauth=1`;
    try { sessionStorage.setItem("agoraedu_gauth", "1"); } catch (e) {}
    window.location.href = `https://accounts.google.com/ServiceLogin?hl=pt-BR&continue=${encodeURIComponent(back)}`;
  };

  const labelCls = "text-[10px] font-bold tracking-widest uppercase text-[#5A6376] mb-1.5 block";
  const inputCls = "w-full rounded-xl px-4 py-3 text-sm border outline-none transition-colors placeholder:text-[#5A6376] focus:border-[#4D6BFE]";
  const inputStyle = { background: "#0B0E15", borderColor: T.border, color: T.text };

  return (
    <div className="min-h-screen flex items-center justify-center p-4 relative overflow-hidden" style={{ background: T.bg }}>
      <div className="absolute inset-0 pointer-events-none" style={{ background: "radial-gradient(ellipse 70% 60% at 50% -10%, rgba(77,107,254,.22), transparent 60%), radial-gradient(ellipse 40% 50% at 90% 110%, rgba(108,140,255,.08), transparent 60%)" }} />
      <motion.div initial={{ opacity: 0, y: 18 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 0.4 }} className="relative w-full max-w-md">
        <div className="flex items-center justify-center gap-3 mb-6">
          <div className="w-11 h-11 rounded-2xl flex items-center justify-center" style={{ background: "linear-gradient(135deg,#4D6BFE,#6C8CFF)" }}>
            <IconScale size={22} className="text-white" />
          </div>
          <div>
            <div className="font-extrabold text-lg tracking-tight text-center">Ágora<span style={{ color: T.accentSoft }}>EDU</span></div>
            <div className="text-[10px] text-[#5A6376] font-semibold tracking-widest uppercase text-center">Educação Política</div>
          </div>
        </div>

        <Card className="p-6 sm:p-7" style={{ boxShadow: "0 24px 80px rgba(0,0,0,.5)" }}>
          <div className="flex rounded-xl p-1 gap-1 mb-6" style={{ background: "#0B0E15", border: `1px solid ${T.border}` }}>
            {[["login", "Entrar"], ["register", "Criar conta"]].map(([m, l]) => (
              <button key={m} type="button" onClick={() => { setMode(m); setError(""); }}
                className="flex-1 py-2 rounded-lg text-xs font-bold transition-all"
                style={mode === m ? { background: T.accent, color: "#fff" } : { color: T.muted }}>
                {l}
              </button>
            ))}
          </div>

          {notice && (
            <div className="mb-4 p-3 rounded-xl text-[11px] leading-relaxed border" style={{ background: `${T.accent}14`, borderColor: `${T.accent}44`, color: "#93AAFF" }}>
              {notice}
            </div>
          )}
          {googleReturn && mode === "login" && (
            <div className="mb-4 p-3 rounded-xl text-[11px] border" style={{ background: `${T.ok}12`, borderColor: `${T.ok}44`, color: T.ok }}>
              Você voltou do Google. Se já possui conta, entre normalmente; caso contrário, conclua o cadastro.
            </div>
          )}

          {mode === "login" ? (
            <form onSubmit={handleLogin} className="space-y-4">
