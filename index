/* ---------- Estado compartilhado (event-sourcing) ---------- */
const emptyData = () => ({
  lecture: null, debate: null, args: [], questions: [], polls: [],
  chat: [], reactions: {}, reports: [], mutes: {}, modLog: [], xpBoard: {},
});

function applyEvent(s, ev) {
  const p = ev.payload || {};
  const d = { ...s };
  switch (ev.type) {
    case "lecture_start": d.lecture = p.lecture; break;
    case "lecture_end": d.lecture = null; break;
    case "debate_start": d.debate = p.debate; break;
    case "debate_extend": d.debate = d.debate ? { ...d.debate, endsAt: p.endsAt, round: p.round ?? d.debate.round } : null; break;
    case "debate_end": d.debate = null; break;
    case "arg_add": if (!d.args.some((a) => a.id === p.arg.id)) d.args = [...d.args, p.arg]; break;
    case "arg_vote": d.args = d.args.map((a) => a.id === p.argId ? { ...a, voters: toggleVoter(a.voters, p.userId, p.on) } : a); break;
    case "q_add": if (!d.questions.some((q) => q.id === p.q.id)) d.questions = [...d.questions, p.q]; break;
    case "q_vote": d.questions = d.questions.map((q) => q.id === p.qid ? { ...q, voters: toggleVoter(q.voters, p.userId, p.on) } : q); break;
    case "q_answer": d.questions = d.questions.map((q) => (q.id === p.qid && !q.answers.some((a) => a.id === p.answer.id)) ? { ...q, answers: [...q.answers, p.answer] } : q); break;
    case "a_vote": d.questions = d.questions.map((q) => q.id === p.qid ? { ...q, answers: q.answers.map((a) => a.id === p.aid ? { ...a, voters: toggleVoter(a.voters, p.userId, p.on) } : a) } : q); break;
    case "q_status": d.questions = d.questions.map((q) => q.id === p.qid ? { ...q, status: p.status } : q); break;
    case "q_remove": d.questions = d.questions.filter((q) => q.id !== p.qid); break;
    case "poll_add": if (!d.polls.some((x) => x.id === p.poll.id)) d.polls = [p.poll, ...d.polls]; break;
    case "poll_vote": d.polls = d.polls.map((x) => x.id === p.pollId ? { ...x, options: x.options.map((o, i) => i === p.idx ? { ...o, voters: toggleVoter(o.voters, p.userId, true) } : o) } : x); break;
    case "poll_close": d.polls = d.polls.map((x) => x.id === p.pollId ? { ...x, closed: true } : x); break;
    case "poll_remove": d.polls = d.polls.filter((x) => x.id !== p.pollId); break;
    case "chat_add": if (!d.chat.some((m) => m.id === p.msg.id)) d.chat = [...d.chat.slice(-120), p.msg]; break;
    case "chat_remove": d.chat = d.chat.filter((m) => m.id !== p.msgId); break;
    case "react": d.reactions = { ...d.reactions, [p.key]: toggleVoter(d.reactions[p.key], p.userId, p.on) }; break;
    case "report_add": if (!d.reports.some((r) => r.id === p.report.id)) d.reports = [p.report, ...d.reports]; break;
    case "report_resolve": d.reports = d.reports.map((r) => r.id === p.reportId ? { ...r, handled: p.action } : r); break;
    case "mute_set": d.mutes = { ...d.mutes, [p.userId]: p.muted }; break;
    case "mod_log_add": d.modLog = [p.entry, ...d.modLog].slice(0, 40); break;
    case "xp_set": d.xpBoard = { ...d.xpBoard, [p.userId]: { userId: p.userId, name: p.name, turma: p.turma, xp: p.xp } }; break;
    default: return s;
  }
  return d;
}

/* ---------- MQTT em tempo real ---------- */
const BROKERS = ["wss://broker.emqx.io:8084/mqtt", "wss://broker.hivemq.com:8884/mqtt"];
let mqttLibPromise = null;
function loadMqttLib() {
  if (window.mqtt) return Promise.resolve(window.mqtt);
  if (!mqttLibPromise) {
    mqttLibPromise = new Promise((res, rej) => {
      const sc = document.createElement("script");
      sc.src = "https://cdn.jsdelivr.net/npm/mqtt@5.10.2/dist/mqtt.min.js";
      sc.onload = () => res(window.mqtt);
      sc.onerror = () => rej(new Error("mqtt-load-failed"));
      document.head.appendChild(sc);
    });
  }
  return mqttLibPromise;
}
function tryConnectBroker(lib, url, clientId) {
  return new Promise((res, rej) => {
    let settled = false;
    let c;
    try { c = lib.connect(url, { clientId, keepalive: 30, reconnectPeriod: 4000, connectTimeout: 8000, clean: true }); }
    catch (e) { return rej(e); }
    const to = setTimeout(() => { if (!settled) { settled = true; try { c.end(true); } catch (e) {} rej(new Error("timeout")); } }, 9000);
    c.once("connect", () => { if (!settled) { settled = true; clearTimeout(to); res(c); } });
    c.once("error", (e) => { if (!settled) { settled = true; clearTimeout(to); try { c.end(true); } catch (_) {} rej(e); } });
  });
}

function useRoomSync(room, me, onRemoteEvent, getSnap) {
  const [status, setStatus] = useState("connecting");
  const [peers, setPeers] = useState({});
  const clientRef = useRef(null);
  const onEvRef = useRef(onRemoteEvent); onEvRef.current = onRemoteEvent;
  const snapRef = useRef(getSnap); snapRef.current = getSnap;
  const lastSnapSent = useRef(0);
  const meRef = useRef(me); meRef.current = me;

  useEffect(() => {
    let cancelled = false;
    let client = null;
    let pingTimer = null, pruneTimer = null;
    const base = `agoraedu/v1/${room}`;
    const cid = getCid();

    const rawPublish = (m) => {
      try {
        if (client && client.connected) {
          client.publish(`${base}/ev`, JSON.stringify({ ...m, from: cid, name: meRef.current.name, role: meRef.current.role, ts: Date.now() }));
          return true;
        }
      } catch (e) {}
      return false;
    };

    (async () => {
      let lib;
      try { lib = await loadMqttLib(); } catch (e) { if (!cancelled) setStatus("offline"); return; }
      for (const url of BROKERS) {
        if (cancelled) return;
        try { client = await tryConnectBroker(lib, url, `agx-${cid}-${Math.random().toString(36).slice(2, 6)}`); break; }
        catch (e) { client = null; }
      }
      if (cancelled) { if (client) { try { client.end(true); } catch (e) {} } return; }
      if (!client) { setStatus("offline"); return; }
      clientRef.current = client;
      setStatus("online");

      client.subscribe([`${base}/ev`, `${base}/pres`]);
      client.on("message", (topic, buf) => {
        try {
          const m = JSON.parse(buf.toString());
          if (String(topic).endsWith("/pres")) {
            if (m.cid !== cid) setPeers((prev) => ({ ...prev, [m.cid]: { name: m.name, role: m.role, uid: m.uid, turma: m.turma, ts: Date.now() } }));
            return;
          }
          if (m.from === cid) return;
          if (m.type === "snap_req") {
            const now = Date.now();
            if (now - lastSnapSent.current > 5000 && snapRef.current) {
              const snap = snapRef.current();
              if (snap && snap.rev > 0) {
                lastSnapSent.current = now;
                setTimeout(() => rawPublish({ id: uid(), type: "snap", payload: { data: snap.data, rev: snap.rev } }), Math.floor(Math.random() * 700));
              }
            }
            return;
          }
          onEvRef.current(m);
        } catch (e) {}
      });

      const ping = () => {
        try {
          if (client && client.connected) client.publish(`${base}/pres`, JSON.stringify({ cid, uid: meRef.current.id, name: meRef.current.name, role: meRef.current.role, turma: meRef.current.turma || "", ts: Date.now() }));
        } catch (e) {}
      };
      ping();
      pingTimer = setInterval(ping, 8000);
      pruneTimer = setInterval(() => setPeers((prev) => {
        const next = {};
        for (const k in prev) if (Date.now() - prev[k].ts < 24000) next[k] = prev[k];
        return next;
      }), 6000);

      setTimeout(() => rawPublish({ id: uid(), type: "snap_req", payload: {} }), 700);

      client.on("close", () => { if (!cancelled) setStatus("reconnecting"); });
      client.on("offline", () => { if (!cancelled) setStatus("reconnecting"); });
      client.on("connect", () => { if (!cancelled) { setStatus("online"); ping(); try { client.subscribe([`${base}/ev`, `${base}/pres`]); } catch (e) {} } });
      client.on("error", () => {});
    })();

    return () => {
      cancelled = true;
      if (pingTimer) clearInterval(pingTimer);
      if (pruneTimer) clearInterval(pruneTimer);
      if (client) { try { client.end(true); } catch (e) {} }
      clientRef.current = null;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [room]);

  const publish = useCallback((msg) => {
    try {
      const c = clientRef.current;
      if (c && c.connected) {
        c.publish(`agoraedu/v1/${room}/ev`, JSON.stringify({ ...msg, from: getCid(), name: meRef.current.name, role: meRef.current.role, ts: Date.now() }));
        return true;
      }
    } catch (e) {}
    return false;
  }, [room]);

  const participantCount = Object.keys(peers).length + 1;
  return { status, peers, participantCount, publish };
}

